From 54b976eb46447e8802802bb80981742355b4c7d3 Mon Sep 17 00:00:00 2001
From: ikanbandengultra <ikanbandengultra@users.noreply.github.com>
Date: Wed, 22 Jul 2026 22:21:04 +0000
Subject: [PATCH] allow network_stack to access fs_bpf file

Change-Id: I11643518b6fbad1a1068db60be13e22fe237382b
---
 private/bpfloader.te | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/private/bpfloader.te b/private/bpfloader.te
index 4fe3843..673d015 100644
--- a/private/bpfloader.te
+++ b/private/bpfloader.te
@@ -34,7 +34,7 @@ neverallow { domain -bpfloader } bpffs_type:dir { add_name create open read remo
 
 neverallow { domain            } bpffs_type:file ~{ create getattr map open read rename setattr write };
 neverallow { domain -bpfloader } bpffs_type:file { create map open rename setattr };
-neverallow { domain -bpfloader -gpuservice -lmkd -mediaprovider_app -netd -netutils_wrapper                -system_server } fs_bpf:file               { getattr read };
+neverallow { domain -bpfloader -gpuservice -lmkd -mediaprovider_app -netd -netutils_wrapper -network_stack -system_server } fs_bpf:file               { getattr read };
 neverallow { domain -bpfloader                                                                                            } fs_bpf_loader:file        { getattr read };
 neverallow { domain -bpfloader                                                              -network_stack                } fs_bpf_net_private:file   { getattr read };
 neverallow { domain -bpfloader                                                              -network_stack -system_server } fs_bpf_net_shared:file    { getattr read };
-- 
2.56.0
