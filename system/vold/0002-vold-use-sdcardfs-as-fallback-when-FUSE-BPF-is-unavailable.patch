From 008f5bea1e21291a0a6264f308f80ad8d99ce699 Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@example.com>
Date: Wed, 29 Apr 2026 14:57:07 +0700
Subject: [PATCH] vold: use sdcardfs as fallback when FUSE BPF is unavailable

---
 model/EmulatedVolume.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/model/EmulatedVolume.cpp b/model/EmulatedVolume.cpp
index 2df35cb..0613b9a 100644
--- a/model/EmulatedVolume.cpp
+++ b/model/EmulatedVolume.cpp
@@ -54,6 +54,12 @@ EmulatedVolume::EmulatedVolume(const std::string& rawPath, int userId)
     mLabel = "emulated";
     mFuseMounted = false;
     mUseSdcardFs = IsSdcardfsUsed();
+    // When FUSE BPF is unavailable, the legacy FUSE path does not correctly
+    // handle writes. Force sdcardfs if the kernel supports it.
+    if (!mUseSdcardFs && !IsFuseBpfEnabled() && IsFilesystemSupported("sdcardfs")) {
+        LOG(INFO) << "FUSE BPF unavailable and sdcardfs supported; forcing sdcardfs";
+        mUseSdcardFs = true;
+    }
     mAppDataIsolationEnabled = base::GetBoolProperty(kVoldAppDataIsolationEnabled, false);
 }
 
@@ -65,6 +71,10 @@ EmulatedVolume::EmulatedVolume(const std::string& rawPath, dev_t device, const s
     mLabel = fsUuid;
     mFuseMounted = false;
     mUseSdcardFs = IsSdcardfsUsed();
+    if (!mUseSdcardFs && !IsFuseBpfEnabled() && IsFilesystemSupported("sdcardfs")) {
+        LOG(INFO) << "FUSE BPF unavailable and sdcardfs supported; forcing sdcardfs";
+        mUseSdcardFs = true;
+    }
     mAppDataIsolationEnabled = base::GetBoolProperty(kVoldAppDataIsolationEnabled, false);
 }
 
