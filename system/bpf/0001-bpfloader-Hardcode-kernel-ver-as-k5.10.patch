From deb2878c59e58c386095b47c2367ac3644cb3194 Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@example.com>
Date: Wed, 29 Apr 2026 14:57:07 +0700
Subject: [PATCH] bpfloader: Hardcode kernel ver as k5.10

Change-Id: Ic7ceb5587b292185bae36fedb2abbcf987e6b631
---
 loader/bpfloader.rs | 24 +++---------------------
 1 file changed, 3 insertions(+), 21 deletions(-)

diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index 34e9b68..ab4c456 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -24,14 +24,9 @@ use libbpf_rs::{
     ProgramType,
 };
 use libbpf_sys::{bpf_map__autocreate, bpf_program__set_type};
-use libc::{
-    mode_t, uname, utsname, S_IRGRP, S_IROTH, S_IRUSR, S_IRWXG, S_IRWXO, S_IRWXU, S_ISVTX, S_IWGRP,
-    S_IWOTH, S_IWUSR,
-};
+use libc::{mode_t, S_IRGRP, S_IROTH, S_IRUSR, S_IRWXG, S_IRWXO, S_IRWXU, S_ISVTX, S_IWGRP, S_IWOTH, S_IWUSR};
 use log::{debug, error, info, warn, Level, LevelFilter, Log, Metadata, Record, SetLoggerError};
 use rustutils::system_properties;
-use std::ffi::CStr;
-use std::mem::MaybeUninit;
 use std::{
     cmp::max,
     env, fs,
@@ -430,21 +425,8 @@ fn kernel_version() -> Result<u32, anyhow::Error> {
         let (major, minor, sub) = parse_release(&kver_override);
         return Ok(kver(major, minor, sub));
     }
-    let mut buf: MaybeUninit<utsname> = MaybeUninit::zeroed();
-    // SAFETY: If uname returns 0, the buf should be properly initialized.
-    if unsafe { uname(buf.as_mut_ptr()) } != 0 {
-        return Err(anyhow!("Failed to call uname system call."));
-    }
-    // SAFETY: `uname` returned 0, so the buf should be properly initialized.
-    let buf = unsafe { buf.assume_init() };
-    // SAFETY: buf.release is part of the utsname struct populated by uname.
-    let release_cstr = unsafe { CStr::from_ptr(buf.release.as_ptr()) };
-    let release = release_cstr
-        .to_str()
-        .map_err(|e| anyhow!("utsname release string is not valid UTF-8: {}", e))?;
-
-    let (major, minor, sub) = parse_release(release);
-    Ok(kver(major, minor, sub))
+    // Hardcode kernel version to 5.10.209.
+    Ok(kver(5, 10, 209))
 }
 
 fn set_skip_loading(
-- 
2.54.0
