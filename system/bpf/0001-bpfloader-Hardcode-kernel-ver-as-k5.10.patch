From 85437f5601dc5b3a88924d1c0def7827d968c9cb Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@example.com>
Date: Wed, 29 Apr 2026 14:57:07 +0700
Subject: [PATCH] bpfloader: Hardcode kernel ver as k5.10

Change-Id: Ic7ceb5587b292185bae36fedb2abbcf987e6b631
---
 loader/bpfloader.rs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index 34e9b68..7278cb3 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -426,6 +426,9 @@ fn parse_release(release: &str) -> (u32, u32, u32) {
 }
 
 fn kernel_version() -> Result<u32, anyhow::Error> {
+    // Hardcode kernel version to 5.10.209.
+    return Ok(kver(5, 10, 209));
+
     if let Some(kver_override) = system_properties::read("ro.bpf.kver_override")? {
         let (major, minor, sub) = parse_release(&kver_override);
         return Ok(kver(major, minor, sub));
-- 
