From c62c424acd07fa33ee6c06361220b18c817a9f35 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 16 Feb 2026 09:43:48 +0000
Subject: [PATCH] KernelUtils: allow overriding kernel version via 
 ro.bpf.kver_override

Add support for the ro.bpf.kver_override system property to fake the
kernel version reported to BPF subsystem version checks. This allows
old-kernel GSI devices to bypass BPF kernel version gates without
requiring an actual kernel upgrade.

When the property is set (e.g. ro.bpf.kver_override=5.4.0), the BPF
subsystem will use the overridden version for all isAtLeastKernelVersion
checks instead of the real uname value.

Change-Id: I5eb71398a46274665e4b179913434278700d6279
---
 bpf/headers/include/bpf/KernelUtils.h | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/bpf/headers/include/bpf/KernelUtils.h b/bpf/headers/include/bpf/KernelUtils.h
index 68bc607..6ea0e0e 100644
--- a/bpf/headers/include/bpf/KernelUtils.h
+++ b/bpf/headers/include/bpf/KernelUtils.h
@@ -19,6 +19,9 @@
 #include <stdio.h>
 #include <string.h>
 #include <sys/personality.h>
+#ifdef __ANDROID__
+#include <sys/system_properties.h>
+#endif
 #include <sys/utsname.h>
 
 namespace android {
@@ -33,6 +36,13 @@ static inline unsigned uncachedKernelVersion() {
     unsigned kver_major = 0;
     unsigned kver_minor = 0;
     unsigned kver_sub = 0;
+#ifdef __ANDROID__
+    char kver_override[PROP_VALUE_MAX];
+    if (__system_property_get("ro.bpf.kver_override", kver_override) > 0) {
+        if (sscanf(kver_override, "%u.%u.%u", &kver_major, &kver_minor, &kver_sub) >= 2)
+            return KVER(kver_major, kver_minor, kver_sub);
+    }
+#endif
     (void)sscanf(buf.release, "%u.%u.%u", &kver_major, &kver_minor, &kver_sub);
     return KVER(kver_major, kver_minor, kver_sub);
 }
