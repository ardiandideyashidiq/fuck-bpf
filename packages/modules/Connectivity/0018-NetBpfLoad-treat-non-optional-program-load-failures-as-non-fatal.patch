From 8eac18b94509ecabce362315f6c0162d1a6fca02 Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@example.com>
Date: Wed, 29 Apr 2026 15:00:29 +0700
Subject: [PATCH] NetBpfLoad: treat non-optional program load failures as
 non-fatal

---
 bpf/loader/NetBpfLoad.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/bpf/loader/NetBpfLoad.cpp b/bpf/loader/NetBpfLoad.cpp
index 716e0c81b1..8e7a1925c9 100644
--- a/bpf/loader/NetBpfLoad.cpp
+++ b/bpf/loader/NetBpfLoad.cpp
@@ -1135,7 +1135,9 @@ static int loadCodeSections(ElfObject& elfObj, vector<codeSection>& cs, const st
                           cs[i].prog_def->name());
                     continue;
                 }
-                ALOGE("non-optional program %s failed to load.", cs[i].prog_def->name());
+                ALOGW("non-optional program %s failed to load, continuing anyway",
+                      cs[i].prog_def->name());
+                continue;
             }
         }
 
