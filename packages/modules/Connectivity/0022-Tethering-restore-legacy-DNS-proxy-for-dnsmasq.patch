From a412ce00b6f51f8b28bbef1d8f0b64bde1e003d6 Mon Sep 17 00:00:00 2001
From: rdndds <rdndds@gmail.com>
Date: Fri, 13 Nov 2026 23:47:34 +0700
Subject: [PATCH] Tethering: restore legacy DNS proxy for dnsmasq

NetworkStack DhcpServer always advertises the downstream tether
interface address as the client DNS server, and neither NetworkStack
nor Connectivity provides a port-53 DNS forwarder on that address.
With usingLegacyDnsProxy=false, netd TetherController skips starting
dnsmasq (or passes --port=0 when legacy DHCP is enabled), so tethered
clients receive ICMP port 53 unreachable on DNS queries.

Restore usingLegacyDnsProxy=true on both tetherStart calls so netd
launches dnsmasq to handle port-53 DNS forwarding.

Change-Id: If812ab4f73ed18aa5e37f1bf53a3018cec2eaebd
---
 .../src/com/android/networkstack/tethering/Tethering.java     | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Tethering/src/com/android/networkstack/tethering/Tethering.java b/Tethering/src/com/android/networkstack/tethering/Tethering.java
index 4dfb4cf..b949587 100644
--- a/Tethering/src/com/android/networkstack/tethering/Tethering.java
+++ b/Tethering/src/com/android/networkstack/tethering/Tethering.java
@@ -1846,12 +1846,12 @@ public class Tethering {
             final String[] dhcpRanges = cfg.useLegacyDhcpServer()
                     ? cfg.legacyDhcpRanges : new String[0];
             try {
-                NetdUtils.tetherStart(mNetd, false /** usingLegacyDnsProxy */, dhcpRanges);
+                NetdUtils.tetherStart(mNetd, true /** usingLegacyDnsProxy */, dhcpRanges);
             } catch (RemoteException | ServiceSpecificException e) {
                 try {
                     // Stop and retry.
                     mNetd.tetherStop();
-                    NetdUtils.tetherStart(mNetd, false /** usingLegacyDnsProxy */, dhcpRanges);
+                    NetdUtils.tetherStart(mNetd, true /** usingLegacyDnsProxy */, dhcpRanges);
                 } catch (RemoteException | ServiceSpecificException ee) {
                     mLog.e(ee);
                     transitionTo(mStartTetheringErrorState);
-- 
