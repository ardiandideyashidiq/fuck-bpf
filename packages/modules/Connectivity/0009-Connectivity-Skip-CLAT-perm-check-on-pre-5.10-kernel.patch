From 698dfdfde72bf005a25ad5cf3514b6ae35882e71 Mon Sep 17 00:00:00 2001
From: Aryan Sinha <techyminati@outlook.com>
Date: Sat, 21 Feb 2026 10:25:40 +0100
Subject: [PATCH] Connectivity: Skip CLAT perm check on pre-5.10 kernels

Some legacy device kernels (4.14/4.19) lack full bpffs selinux
genfscon support required by the Connectivity APEX CLAT
permission verification logic. This causes verifyClatPerms()
to trigger a fatal abort during JNI_OnLoad, leading to a
system_server crash at boot.

Previous Trebledroid patch relaxes this requirement for GSI builds, but
device builds on legacy kernels are also intentionally
supported in custom ROMs.

Move the legacy-kernel guard before any BPF filesystem or
object verification so devices below 5.10 return before the
abort path is reached. Parse uname().release directly for this
early gate so the check matches the actual running vendor kernel.

This allows devices with older vendor kernels to boot
successfully without full BPF/CLAT support.
---
 ...id_server_connectivity_ClatCoordinator.cpp | 35 ++++++++++++++-----
 1 file changed, 27 insertions(+), 8 deletions(-)

diff --git a/service/jni/com_android_server_connectivity_ClatCoordinator.cpp b/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
index 437e78f..25dd122 100644
--- a/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
+++ b/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
@@ -26,8 +26,10 @@
 #include <nativehelper/JNIHelp.h>
 #include <net/if.h>
 #include <spawn.h>
+#include <stdio.h>
 #include <sys/stat.h>
 #include <sys/types.h>
+#include <sys/utsname.h>
 #include <sys/wait.h>
 #include <sys/xattr.h>
 #include <string>
@@ -99,6 +101,24 @@ bool isGsiImage() {
 static const char* kClatdDir = "/apex/com.android.tethering/bin/for-system";
 static const char* kClatdBin = "/apex/com.android.tethering/bin/for-system/clatd";
 
+static bool isRunningKernelAtLeast(unsigned int minMajor, unsigned int minMinor) {
+    struct utsname uts = {};
+    if (uname(&uts)) {
+        ALOGW("uname failed, falling back to BpfUtils kernel version check: errno=%d", errno);
+        return bpf::isAtLeastKernelVersion(minMajor, minMinor, 0);
+    }
+
+    unsigned int major = 0;
+    unsigned int minor = 0;
+    if (sscanf(uts.release, "%u.%u", &major, &minor) != 2) {
+        ALOGW("Could not parse kernel release '%s', falling back to BpfUtils kernel version check",
+              uts.release);
+        return bpf::isAtLeastKernelVersion(minMajor, minMinor, 0);
+    }
+
+    return major > minMajor || (major == minMajor && minor >= minMinor);
+}
+
 #define V(path, md, uid, gid, ctx, vtype) \
     verifyPerms((path), (md), AID_ ## uid, AID_ ## gid, "u:object_r:" ctx ":s0", VERIFY_ ## vtype)
 
@@ -112,6 +132,13 @@ static void verifyClatPerms() {
     V(kClatdDir, S_IFDIR|0750, CLAT, SYSTEM, "system_file", DIR);
     V(kClatdBin, S_IFREG|S_ISUID|S_ISGID|0755, CLAT, CLAT, "clatd_exec", BIN);
 
+    // HACK: Some old vendor kernels lack ~5.10 backport of 'bpffs selinux genfscon' support.
+    // This is *NOT* supported, but let's allow, at least for now, to make 16 QPR2 boot on them.
+    if (!isRunningKernelAtLeast(5, 10)) {
+        ALOGW("Kernel < 5.10 detected, skipping CLAT perms for legacy kernel.");
+        return;
+    }
+
     // Move on to verifying that the bpf programs and maps are as expected.
     // This relies on the kernel and bpfloader.
 
@@ -137,14 +164,6 @@ static void verifyClatPerms() {
 
 #undef V2
 
-    // HACK: Some old vendor kernels lack ~5.10 backport of 'bpffs selinux genfscon' support.
-    // This is *NOT* supported, but let's allow, at least for now, U+ GSI to boot on them.
-    // (without this hack pixel5 R vendor + U gsi breaks)
-    if (isGsiImage() && !bpf::isAtLeastKernelVersion(5, 10, 0)) {
-        ALOGE("GSI with *BAD* pre-5.10 kernel lacking bpffs selinux genfscon support.");
-        return;
-    }
-
     if (fatal) abort();
 }
 
-- 
