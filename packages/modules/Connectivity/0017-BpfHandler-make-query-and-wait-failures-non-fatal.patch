From 104e0322c3163006c936a8c423f6794bef574a2f Mon Sep 17 00:00:00 2001
From: OpenCode <opencode@example.com>
Date: Wed, 29 Apr 2026 15:00:14 +0700
Subject: [PATCH] BpfHandler: make query and wait failures non-fatal

Change-Id: Iba5f3d98d64bfc39f8beb2845b9857940664dab0
---
 bpf/netd/BpfHandler.cpp | 70 ++++++++++++++++++++++++++++-------------
 1 file changed, 49 insertions(+), 21 deletions(-)

diff --git a/bpf/netd/BpfHandler.cpp b/bpf/netd/BpfHandler.cpp
index c5b83d4..91b9f9d 100644
--- a/bpf/netd/BpfHandler.cpp
+++ b/bpf/netd/BpfHandler.cpp
@@ -150,32 +150,46 @@ static Status initPrograms(const char* cg2_path) {
 
         // This should trivially pass, since we just attached up above,
         // but BPF_PROG_QUERY is only implemented on 4.19+ kernels.
-        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_EGRESS) <= 0) abort();
-        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_INGRESS) <= 0) abort();
-        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_SOCK_CREATE) <= 0) abort();
-        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET4_BIND) <= 0) abort();
-        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET6_BIND) <= 0) abort();
+        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_EGRESS) <= 0)
+            ALOGW("BPF_CGROUP_INET_EGRESS query failed, continuing anyway");
+        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_INGRESS) <= 0)
+            ALOGW("BPF_CGROUP_INET_INGRESS query failed, continuing anyway");
+        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_SOCK_CREATE) <= 0)
+            ALOGW("BPF_CGROUP_INET_SOCK_CREATE query failed, continuing anyway");
+        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET4_BIND) <= 0)
+            ALOGW("BPF_CGROUP_INET4_BIND query failed, continuing anyway");
+        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET6_BIND) <= 0)
+            ALOGW("BPF_CGROUP_INET6_BIND query failed, continuing anyway");
     }
 
     if (bpf::isAtLeastKernelVersion(5, 10, 0)) {
-        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_SOCK_RELEASE) <= 0) abort();
+        if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET_SOCK_RELEASE) <= 0)
+            ALOGW("BPF_CGROUP_INET_SOCK_RELEASE query failed, continuing anyway");
     }
 
     if (modules::sdklevel::IsAtLeastV()) {
         // V requires 4.19+, so technically this 2nd 'if' is not required, but it
         // doesn't hurt us to try to support AOSP forks that try to support older kernels.
         if (bpf::isAtLeastKernelVersion(4, 19, 0)) {
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET4_CONNECT) <= 0) abort();
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET6_CONNECT) <= 0) abort();
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP4_RECVMSG) <= 0) abort();
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP6_RECVMSG) <= 0) abort();
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP4_SENDMSG) <= 0) abort();
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP6_SENDMSG) <= 0) abort();
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET4_CONNECT) <= 0)
+                ALOGW("BPF_CGROUP_INET4_CONNECT query failed, continuing anyway");
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_INET6_CONNECT) <= 0)
+                ALOGW("BPF_CGROUP_INET6_CONNECT query failed, continuing anyway");
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP4_RECVMSG) <= 0)
+                ALOGW("BPF_CGROUP_UDP4_RECVMSG query failed, continuing anyway");
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP6_RECVMSG) <= 0)
+                ALOGW("BPF_CGROUP_UDP6_RECVMSG query failed, continuing anyway");
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP4_SENDMSG) <= 0)
+                ALOGW("BPF_CGROUP_UDP4_SENDMSG query failed, continuing anyway");
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_UDP6_SENDMSG) <= 0)
+                ALOGW("BPF_CGROUP_UDP6_SENDMSG query failed, continuing anyway");
         }
 
         if (bpf::isAtLeastKernelVersion(5, 4, 0)) {
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_GETSOCKOPT) <= 0) abort();
-            if (bpf::queryProgram(cg_fd, BPF_CGROUP_SETSOCKOPT) <= 0) abort();
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_GETSOCKOPT) <= 0)
+                ALOGW("BPF_CGROUP_GETSOCKOPT query failed, continuing anyway");
+            if (bpf::queryProgram(cg_fd, BPF_CGROUP_SETSOCKOPT) <= 0)
+                ALOGW("BPF_CGROUP_SETSOCKOPT query failed, continuing anyway");
         }
     }
 
@@ -196,14 +210,19 @@ static bool mainlineNetBpfLoadDone() {
 // copied with minor changes from waitForProgsLoaded()
 // p/m/C's staticlibs/native/bpf_headers/include/bpf/WaitForProgsLoaded.h
 static inline void waitForNetProgsLoaded() {
-    // infinite loop until success with 5/10/20/40/60/60/60... delay
+    // loop until mdnsd_netbpfload stops with 5/10/20/40/60/60/60... delay
     for (int delay = 5;; delay *= 2) {
         if (delay > 60) delay = 60;
-        if (WaitForProperty("init.svc.mdnsd_netbpfload", "stopped", std::chrono::seconds(delay))
-            && mainlineNetBpfLoadDone())
-            return;
+        if (WaitForProperty("init.svc.mdnsd_netbpfload", "stopped", std::chrono::seconds(delay))) {
+            break;
+        }
         ALOGW("Waited %ds for init.svc.mdnsd_netbpfload=stopped, still waiting...", delay);
     }
+    if (!mainlineNetBpfLoadDone()) {
+        ALOGE("init.svc.mdnsd_netbpfload=stopped, yet !mainlineNetBpfLoadDone");
+        ALOGW("Continuing without mainline BPF programs loaded");
+        return;
+    }
 }
 
 static inline void waitForBpf() {
@@ -225,7 +244,8 @@ static inline void waitForBpf() {
         // so waitForProgsLoaded() implies mainlineNetBpfLoadDone().
         if (!base::SetProperty("ctl.start", "mdnsd_netbpfload")) {
             ALOGE("Failed to set property ctl.start=mdnsd_netbpfload, see dmesg for reason.");
-            abort();
+            ALOGW("Continuing without mdnsd_netbpfload");
+            return;
         }
 
         ALOGI("Waiting for Networking BPF programs");
@@ -261,9 +281,17 @@ static void mapLockTest(void) {
     const char * const m1 = BPF_NETD_PATH "map_netd_lock_array_test_map";
     const char * const m2 = BPF_NETD_PATH "map_netd_lock_hash_test_map";
 
-    unique_fd fd0(bpf::mapRetrieveExclusiveRW(m1)); if (!fd0.ok()) abort();  // grabs exclusive lock
+    unique_fd fd0(bpf::mapRetrieveExclusiveRW(m1));
+    if (!fd0.ok()) {
+        ALOGW("mapLockTest: failed to retrieve %s, skipping lock test", m1);
+        return;
+    }
 
-    unique_fd fd1(bpf::mapRetrieveExclusiveRW(m2)); if (!fd1.ok()) abort();  // no conflict with fd0
+    unique_fd fd1(bpf::mapRetrieveExclusiveRW(m2));
+    if (!fd1.ok()) {
+        ALOGW("mapLockTest: failed to retrieve %s, skipping lock test", m2);
+        return;
+    }
     unique_fd fd2(bpf::mapRetrieveExclusiveRW(m2)); if ( fd2.ok()) abort();  // busy due to fd1
     unique_fd fd3(bpf::mapRetrieveRO(m2));          if (!fd3.ok()) abort();  // no lock taken
     unique_fd fd4(bpf::mapRetrieveRW(m2));          if ( fd4.ok()) abort();  // busy due to fd1
-- 
2.56.0
