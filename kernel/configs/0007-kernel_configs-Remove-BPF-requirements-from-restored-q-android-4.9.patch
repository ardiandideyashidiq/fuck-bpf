From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aryan Sinha <techyminati@outlook.com>
Date: Wed, 27 May 2026 00:00:00 +0700
Subject: [PATCH] kernel_configs: Remove BPF requirements from restored q/android-4.9

The q/android-4.9 restore patch brings back the old config files from
upstream history. Keep that compatibility path usable on BPF-less legacy
kernels by removing the BPF-related requirements after the restore.
---
 q/android-4.9/android-base.config | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/q/android-4.9/android-base.config b/q/android-4.9/android-base.config
index 136c2c2..f101d89 100644
--- a/q/android-4.9/android-base.config
+++ b/q/android-4.9/android-base.config
@@ -20,10 +20,8 @@ CONFIG_BINFMT_SCRIPT=y
 CONFIG_BLK_DEV_INITRD=y
 CONFIG_BLK_DEV_LOOP=y
 CONFIG_BLOCK=y
-CONFIG_BPF_SYSCALL=y
 CONFIG_CC_STACKPROTECTOR_STRONG=y
 CONFIG_CGROUPS=y
-CONFIG_CGROUP_BPF=y
 CONFIG_CGROUP_CPUACCT=y
 CONFIG_CGROUP_FREEZER=y
 CONFIG_CGROUP_SCHED=y
@@ -106,7 +104,6 @@ CONFIG_MULTIUSER=y
 CONFIG_NET=y
 CONFIG_NETDEVICES=y
 CONFIG_NETFILTER=y
-CONFIG_NETFILTER_XT_MATCH_BPF=y
 CONFIG_NETFILTER_XT_MATCH_COMMENT=y
 CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
 CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
@@ -142,7 +139,6 @@ CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
 CONFIG_NETFILTER_XT_TARGET_TPROXY=y
 CONFIG_NETFILTER_XT_TARGET_TRACE=y
 CONFIG_NET_CLS_ACT=y
-CONFIG_NET_CLS_BPF=y
 CONFIG_NET_CLS_U32=y
 CONFIG_NET_EMATCH=y
 CONFIG_NET_EMATCH_U32=y
-- 
2.54.0
